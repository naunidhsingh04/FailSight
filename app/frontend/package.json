{
  "name": "failsight-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "lighthouse": "node tests/lighthouse.mjs",
    "test:demo": "node -e \"process.env.DEMO_ONLY='1';require('child_process').spawnSync('npx',['playwright','test'],{stdio:'inherit',shell:true,env:process.env})\"",
    "test:replay": "node -e \"process.env.REPLAY_ONLY='1';require('child_process').spawnSync('npx',['playwright','test'],{stdio:'inherit',shell:true,env:process.env})\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/source-serif-4": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "lighthouse": "^12.2.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
